# MySQL / MariaDB (Neoserv). Posebna znaka v geslu URL-kodirajte.
# connection_limit=1 omeji povezave posamezne strežniške funkcije (deljeni gostitelj ima nizek limit).
DATABASE_URL="mysql://UPORABNIK:GESLO@mysql.primer.neoserv.si:3306/IME_BAZE?connection_limit=1&connect_timeout=15&pool_timeout=15"

# Žeton trgovine Vercel Blob (Vercel → Storage → Blob → .env.local / projektne spremenljivke).
# Brez žetona se datoteke v lokalnem razvoju shranijo v mapo .data/files.
BLOB_READ_WRITE_TOKEN=""

# 32 bajtov, hex (64 znakov). openssl rand -hex 32
# Ključ za AES-256-GCM gesla naprav, alarmne kode in WiFi. Brez njega šifriranih podatkov ni mogoče prebrati.
# Ob menjavi ključa starih skrivnosti ni več mogoče odkleniti. Ključa ne dajajte v git in ne v varnostno kopijo ZIP.
ENCRYPTION_KEY=""

# Skrivnost za podpis sejne piškotke. openssl rand -base64 32
AUTH_SECRET=""

# 1 = ob zagonu skripte db:seed napolni PRAZNO bazo z demo podatki (enako kot --demo).
SEED_DEMO="0"
